<!DOCTYPE html>
<html>

<head>

    <title>Employees</title>

    <link rel="stylesheet"
          href="/css/style.css">

</head>

<body>

<nav>

    <h2>ERP Admin Panel</h2>

    <div>
        <a href="/dashboard">
            Dashboard
        </a>

        <a href="/employees">
            Employees
        </a>

        <a href="/logout">
            Logout
        </a>
    </div>

</nav>

<div class="container">

    <div class="page-header">

        <h1>Employees</h1>

        <a
            href="/employees/add"
            class="button"
        >
            Add Employee
        </a>

    </div>


    <table>

        <thead>

            <tr>
                <th>Emp ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Designation</th>
                <th>Basic</th>
                <th>Gross</th>
                <th>Net Salary</th>
                <th>Actions</th>
            </tr>

        </thead>

        <tbody>

        <% employees.forEach(employee => { %>

            <tr>

                <td>
                    <%= employee.empid %>
                </td>

                <td>
                    <%= employee.name %>
                </td>

                <td>
                    <%= employee.email %>
                </td>

                <td>
                    <%= employee.department %>
                </td>

                <td>
                    <%= employee.designation %>
                </td>

                <td>
                    ₹<%= employee.basicSalary.toFixed(2) %>
                </td>

                <td>
                    ₹<%= employee.grossSalary.toFixed(2) %>
                </td>

                <td>
                    ₹<%= employee.netSalary.toFixed(2) %>
                </td>

                <td>

                    <a
                        href="/employees/edit/<%= employee._id %>"
                    >
                        Edit
                    </a>

                    <form
                        action="/employees/delete/<%= employee._id %>"
                        method="POST"
                        style="display:inline"
                    >

                        <button
                            type="submit"
                            onclick="return confirm(
                                'Delete this employee?'
                            )"
                        >
                            Delete
                        </button>

                    </form>

                </td>

            </tr>

        <% }) %>

        </tbody>

    </table>

</div>

</body>
</html>
