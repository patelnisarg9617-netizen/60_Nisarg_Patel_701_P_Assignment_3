<!DOCTYPE html>
<html>
<head>
    <title>ERP Admin Login</title>

    <link rel="stylesheet"
          href="/css/style.css">
</head>

<body>

<div class="login-container">

    <h1>ERP Admin Login</h1>

    <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
    <% } %>

    <form action="/login"
          method="POST">

        <label>Email</label>

        <input
            type="email"
            name="email"
            required
        >

        <label>Password</label>

        <input
            type="password"
            name="password"
            required
        >

        <button type="submit">
            Login
        </button>

    </form>

</div>

</body>
</html>
